<Window x:Class="igraUP.Views.WarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:igraUP.Views"
        mc:Ignorable="d"
        Title="WarningWindow" Height="600" Width="810" Background="#000000" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" HorizontalAlignment="Left" Grid.Column="0" Grid.ColumnSpan="2" FontSize="22" FontFamily="Cyberpunk" Foreground="#b30000" Text="ПРЕДУПРЕЖДЕНИЕ О СВЕТОЧУВСТВИТЕЛЬНОСТИ" Margin="9,79,0,0" Height="187" VerticalAlignment="Top" />
        <TextBlock Grid.Row="0" HorizontalAlignment="Center" Grid.Column="0"  Grid.ColumnSpan="2" Grid.RowSpan="2" FontSize="20" FontFamily="Cyberpunk" TextWrapping="Wrap" Foreground="#b30000" Text="В этой игре содержатся визуальные эффекты, включая вспышки света и частую смену кадров, которые могут вызвать эпилептические припадки или ухудшение самочувствия у людей с повышенной светочувствительностью.
Если вы или кто-то из вашей семьи страдает эпилепсией, проконсультируйтесь с врачом перед началом игры. Если во время игры вы почувствуете головокружение, тошноту или двоение в глазах, немедленно прекратите сессию и обратитесь к специалисту." Margin="51,140,51,40"
/>

    </Grid>
</Window>
