<Window x:Class="igraUP.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
 xmlns:lofi="clr-namespace:LoFiEffects.WPF.Effects;assembly=LoFiEffects.WPF"
        xmlns:local="clr-namespace:igraUP"
        mc:Ignorable="d"
        Title="Вход и регистрация" Width="1280"
Height="720"
MinWidth="1280"
MinHeight="720"
WindowStyle="None" WindowState="Maximized" Background="#A8D900">

    <Grid>
        <Grid>
        <Rectangle>
            <Rectangle.Fill>
                <VisualBrush TileMode="Tile"
                         Viewport="-65,0,200,50"
                         ViewportUnits="Absolute"
                         Stretch="None">
                    <VisualBrush.Visual>
                        <StackPanel>
                                <TextBlock x:Name="background1" Text="ERROR?"
                                   FontFamily="Cyberpunk"
                                   HorizontalAlignment="Left"
                                   FontSize="20">
                                <TextBlock.Effect>
                                    <lofi:NoiseEffect Density="1" Intensity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                                <TextBlock x:Name="background2" Text="I DONT CARE."
                                   FontFamily="Cyberpunk"
                                   HorizontalAlignment="Left"
                                   FontSize="19">
                                <TextBlock.Effect>
                                        <lofi:NoiseEffect Density="1" Intensity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
    
    <Grid>
        <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            

            <TextBlock Grid.Row="0" Grid.Column="1"
                   Text="VOID//RUN"
                   FontFamily="Cyberpunk"
                   FontSize="20"
                   Foreground="#000000"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   />

            <Border Grid.Row="1" Grid.Column="1"
                Background="#00D9D9"
                BorderBrush="#A8D900"
                BorderThickness="3"
                Padding="40"
                MaxWidth="600"
                VerticalAlignment="Center">

                <StackPanel Orientation="Vertical">

                    <Border Background="#D900C7"
                        Padding="10,4"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,15">
                        <TextBlock Text="Вход в аккаунт"
                               FontFamily="Cyberpunk"
                               FontSize="18"
                               Foreground="#00D9D9"/>
                    </Border>

                    <TextBlock Text="ENTER THE VOID"
                           FontFamily="Cyberpunk"
                           FontSize="40"
                           Foreground="#D900C7"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                    <TextBlock Text="Логин"
                           FontFamily="Press Start 2P"
                           FontSize="16"
                           Foreground="#000000"
                           Margin="0,0,0,15"/>

                    <TextBox x:Name="LoginBox"
                         Background="#F5F0C8"
                         Foreground="#000000"
                         FontFamily="Press Start 2P"
                         FontSize="16"
                         Padding="10"
                         MinHeight="45"
                         BorderThickness="0"
                         Margin="0,0,0,18"/>

                    <TextBlock Text="Пароль"
                           FontFamily="Press Start 2P"
                           FontSize="16"
                           Foreground="#000000"
                           Margin="0,0,0,15"/>

                    <PasswordBox x:Name="PasswordBox"
                             Background="#F5F0C8"
                             Foreground="#000000"
                             FontFamily="Press Start 2P"
                             FontSize="16"
                             Padding="10"
                             MinHeight="45"
                             BorderThickness="0"
                             Margin="0,0,0,25"/>

                    <TextBlock x:Name="PassNotes"
                           FontFamily="Press Start 2P"
                           FontSize="16"
                           Foreground="#D900C7"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                    <Button Content="ВОЙТИ"
                        FontFamily="Press Start 2P"
                        FontSize="18"
                        Background="#9B00FF"
                        Foreground="#000000"
                        Padding="30,10"
                        HorizontalAlignment="Center"
                        MinWidth="200"
                        Margin="0,0,0,10"
                        Click="Login_Click"/>

                    <Button Content="ЗАРЕГИСТРИРОВАТЬСЯ"
                        FontFamily="Press Start 2P"
                        FontSize="18"
                        Background="#9B00FF"
                        Foreground="#000000"
                        Padding="20,10"
                        HorizontalAlignment="Center"
                        MinWidth="200"
                        Click="Register_Click"/>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>