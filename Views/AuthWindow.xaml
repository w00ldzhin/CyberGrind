<Window x:Class="igraUP.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
 xmlns:lofi="clr-namespace:LoFiEffects.WPF.Effects;assembly=LoFiEffects.WPF"
        xmlns:local="clr-namespace:igraUP"
        mc:Ignorable="d"
        Title="Вход и регистрация" Width="2560" Height="1440" WindowState="Maximized" FontFamily="Tektur" Background="#A8D900">


    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Rectangle Fill="#FF00D9D9" Stroke="#FFA8D900" Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="4" Grid.RowSpan="8">
            
        </Rectangle>
        <Rectangle Fill="#D900C7" Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="2" Margin="80, 10, 10, 50">

        </Rectangle>

        <TextBlock Text="Вход в аккаунт" Foreground="#FF00D9D9" FontFamily="Cyberpunk" Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="2" Margin="90, 15, 30, 65" FontSize="35">
            
        </TextBlock>

        <TextBlock Text="ENTER THE VOID" Foreground="#D900C7" FontFamily="Cyberpunk" Grid.Row="3" Grid.Column="4" Grid.RowSpan="2" Grid.ColumnSpan="4" Margin="42,87,0,0" FontSize="60" HorizontalAlignment="Center">

        </TextBlock>
        <TextBlock Grid.Row="4" Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Top" Text="Логин:"  FontFamily="Press Start 2P" FontSize="36"  Foreground="#000000" Margin="77,90,0,0" Grid.ColumnSpan="2" Grid.RowSpan="2">
          
        </TextBlock>
        <TextBox x:Name="LoginBox" Background="#F5F0C8"  Grid.Row="4" Grid.RowSpan="2" Grid.Column="4" Grid.ColumnSpan="4" Height="65" Foreground="#000000" Margin="77,130,70,0" FontFamily="Press Start 2P">
           
        </TextBox>
        <TextBlock Grid.Row="5"  Grid.RowSpan="2" Grid.Column="4" Grid.ColumnSpan="2" Text="Пароль:"  FontFamily="Press Start 2P" FontSize="36" Foreground="#000000" Margin="77,120,0,0">
         
        </TextBlock>
        <PasswordBox x:Name="PasswordBox" Background="#F5F0C8" Grid.Row="5"  Grid.RowSpan="3"  Grid.Column="4" Grid.ColumnSpan="4" Height="65" Foreground="#000000" FontFamily="Press Start 2P" Margin="77,75,70,0" >
            
        </PasswordBox>

        <Button Grid.Row="4" Grid.Column="2" Height="95" Margin="10" Content="Войти" FontSize="24" Background="#B6FF00" Click="Login_Click" BorderBrush="Black">
          
        </Button>

        <Button Grid.Row="4" Grid.Column="3" Height="95" Margin="10"  Click="Register_Click" Content="Зарегестрироваться" FontSize="24" Background="{x:Null}" BorderBrush="#B6FF00" Foreground="#B6FF00">
           
        </Button>
        <TextBlock x:Name="PassNotes" Background="{x:Null}" FontSize="25" VerticalAlignment="Bottom" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Height="35" Foreground="#FFFF0013"  >
         
        </TextBlock>
    </Grid>
</Window>
